# Streamlit OIDC authentication config for the SCF Compliance Agent frontend.
#
# Copy this file to `.streamlit/secrets.toml` (git-ignored) and fill in the
# values for your identity provider. Streamlit reads the [auth] section
# automatically for st.login() / st.user.
#
# The example below targets the Cognito user pool defined in
# terraform/cognito-a2a.tf. Any OpenID Connect provider works
# (Entra ID, Okta, Google, Auth0, etc.).

[auth]
# Where the app redirects back to after login. Must match a callback URL
# registered on your OIDC client (cognito_a2a_web_callback_urls in Terraform).
redirect_uri = "http://localhost:8501/oauth2callback"

# A long random string used to sign the auth session cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "CHANGE_ME_generate_a_long_random_string"

# OIDC client credentials from your provider.
# For Cognito, create an app client with the authorization-code flow and the
# `openid`/`email` scopes (the a2a_web client in cognito-a2a.tf is a template).
client_id = "your-cognito-app-client-id"
client_secret = "your-cognito-app-client-secret"

# OIDC discovery document. For Cognito:
#   https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration
server_metadata_url = "https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"

# Optional: extra parameters passed to the provider's authorize endpoint.
# [auth.client_kwargs]
# prompt = "login"
